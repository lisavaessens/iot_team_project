# PlantPal - instellingen voor de Raspberry Pi
#
# setup_pi.sh maakt hiervan automatisch een kopie "config.env".
# config.env staat in .gitignore: wachtwoorden komen dus NIET op GitHub.
#
# Tip: gebruik op beide Pi's dezelfde gebruiker en hetzelfde wachtwoord.
# Dan kan de Pico met elk van jullie Pi's verbinden zonder iets aan te passen.

# Poort van de MQTT-broker (standaard 1883)
MQTT_PORT=1883

# Login voor de broker.
# Laat MQTT_USER leeg (MQTT_USER=) voor een broker zonder login, zoals in de
# les-oefeningen. Vul je wel een gebruiker in, dan moeten ALLE scripts inloggen,
# ook je oude oefenscripts (client.username_pw_set(...)).
MQTT_USER=plantpal
MQTT_PASS=plak_hier_het_wachtwoord



# --- InfluxDB (stap 3) ---
INFLUX_URL=http://localhost:8086
INFLUX_ORG=PlantPal
INFLUX_BUCKET=plantpal_metingen
INFLUX_TOKEN=plak_hier_je_eigen_token