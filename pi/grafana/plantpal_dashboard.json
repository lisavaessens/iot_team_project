    {
      "id": 6,
      "title": "Bodemvocht en droogtedrempel",
      "description": "Zakt bodemvocht onder de drempel (potmeter), dan heeft de plant dorst.",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "plantpal-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "plantpal-influx"
          },
          "query": "from(bucket: \"__BUCKET__\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"plantpal\" and r.bron == \"pico\")\n  |> filter(fn: (r) => r._field == \"bodemvocht\" or r._field == \"drempel\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels._field}",
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
