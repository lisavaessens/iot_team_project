{
  "uid": "plantpal",
  "title": "PlantPal",
  "tags": [
    "plantpal"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Hoe gaat het met de plant?",
      "description": "De stemming die de Pico berekent: reservoir leeg > dorst > te warm > slapen > blij",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "plantpal-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "plantpal-influx"
          },
          "query": "from(bucket: \"__BUCKET__\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"plantpal\" and r.bron == \"pico\")\n  |> filter(fn: (r) => r._field == \"stemming\")\n  |> last()\n  |> keep(columns: [\"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Stemming",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "blij": {
                  "text": "Blij",
                  "color": "green",
                  "index": 0
                },
                "dorst": {
                  "text": "Dorst!",
                  "color": "red",
                  "index": 1
                },
                "te_warm": {
                  "text": "Te warm",
                  "color": "orange",
                  "index": 2
                },
                "slapen": {
                  "text": "Slaapt",
                  "color": "blue",
                  "index": 3
                },
                "reservoir_leeg": {
                  "text": "Reservoir leeg",
                  "color": "purple",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
