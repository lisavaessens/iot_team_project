    {
      "id": 13,
      "type": "text",
      "title": "Water geven",
      "description": "Stuurt plantpal/cmd/water naar de Pico (via water_knop.py op de Pi, poort 8080). Werkt de knop niet? Kies bovenaan bij 'Pi-adres' het IP van de Pi.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "html",
        "content": "<div style='text-align:center'><a href=\"http://${pi}:8080/water?seconden=2\" target=\"_blank\" style=\"display:inline-block;padding:10px 18px;margin:4px;border-radius:6px;background:#1f60c4;color:#fff;text-decoration:none;font-size:16px\">2 seconden water</a> &nbsp; <a href=\"http://${pi}:8080/water?seconden=3\" target=\"_blank\" style=\"display:inline-block;padding:10px 18px;margin:4px;border-radius:6px;background:#1f60c4;color:#fff;text-decoration:none;font-size:16px\">3 seconden water</a> &nbsp; <a href=\"http://${pi}:8080/water?seconden=5\" target=\"_blank\" style=\"display:inline-block;padding:10px 18px;margin:4px;border-radius:6px;background:#1f60c4;color:#fff;text-decoration:none;font-size:16px\">5 seconden water</a><p style='margin-top:8px;opacity:.7'>Opent een nieuw tabblad. Onder 10 % waterpeil weigert de Pico te pompen.</p></div>"
      }
    },
    {
